// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum user_role {
  CUSTOMER
  ORGANIZER
}

enum txn_status {
  WAITING_PAYMENT
  WAITING_CONFIRMATION
  DONE
  REJECTED
  EXPIRED
  CANCELED
}

enum discount_type {
  PERCENT
  FIXED
}

enum ticket_status {
  VALID
  CHECKED_IN
  REFUNDED
  VOID
}

// =========================================
// MODELS
// =========================================

model users {
  id             String  @id @default(uuid())
  email          String  @unique @db.VarChar(100)
  password       String
  full_name      String  @db.VarChar(50)
  phone_number   String  @db.VarChar(15)
  referral_code  String  @unique
  referred_by_id String?

  role                  user_role @default(CUSTOMER)
  refresh_token_version Int       @default(0)

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  // Relations
  referred_by               users?                @relation("UserReferrals", fields: [referred_by_id], references: [id])
  referrals                 users[]               @relation("UserReferrals")
  profile                   user_profiles?
  organizer                 organizers?
  transactions              transactions[]
  coupon_issuance           coupon_issuances[]
  point_ledgers             point_ledger[]
  reviews                   reviews[]
  checkins                  checkins[]
  email_notifications       email_notifications[]
  referral_uses_as_referrer referral_uses[]       @relation("Referrer")
  referral_uses_as_referee  referral_uses?        @relation("Referee")

  @@map("users")
}

model user_profiles {
  user_id          String    @id
  display_name     String    @db.VarChar(50)
  avatar_url       String?
  bio              String?   @db.VarChar(50)
  reset_token_hash String?
  reset_token_exp  DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  user users @relation(fields: [user_id], references: [id])

  @@map("user_profiles")
}

model organizers {
  id          String  @id @default(uuid())
  user_id     String  @unique
  brand_name  String? @db.VarChar(50)
  description String? @db.VarChar(300)
  website     String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  user         users          @relation(fields: [user_id], references: [id])
  events       events[]
  vouchers     vouchers[]
  transactions transactions[]

  @@map("organizers")
}

model categories {
  id     String   @id @default(uuid())
  name   String   @db.VarChar(50)
  events events[]

  @@map("categories")
}

model events {
  id              String   @id @default(uuid())
  organizer_id    String
  title           String
  description     String
  category_id     String
  address         String
  city            String
  province        String
  country         String
  start_time      DateTime
  end_time        DateTime
  capacity        Int
  seats_available Int
  is_published    Boolean  @default(false)

  created_at DateTime  @default(now())
  updated_at DateTime
  deleted_at DateTime?

  organizer         organizers          @relation(fields: [organizer_id], references: [id])
  category          categories          @relation(fields: [category_id], references: [id])
  ticket_types      ticket_types[]
  vouchers          vouchers[]
  transaction_items transaction_items[]
  tickets           tickets[]
  reviews           reviews[]

  @@map("events")
}

model ticket_types {
  id         String   @id @default(uuid())
  event_id   String
  name       String
  price_idr  Decimal  @default(0)
  quota      Int
  sale_start DateTime
  sale_end   DateTime
  is_active  Boolean  @default(true)

  created_at DateTime  @default(now())
  update_at  DateTime  @updatedAt()
  deleted_at DateTime?

  event             events              @relation(fields: [event_id], references: [id])
  transaction_items transaction_items[]
  tickets           tickets[]

  @@map("ticket_types")
}

model vouchers {
  id           String        @id @default(uuid())
  organizer_id String
  event_id     String
  code         String        @unique
  type         discount_type
  value        Decimal
  max_uses     Int
  used_count   Int           @default(0)
  starts_at    DateTime
  ends_at      DateTime
  is_active    Boolean       @default(true)

  created_at DateTime  @default(now())
  update_at  DateTime  @updatedAt
  deleted_at DateTime?

  organizer    organizers     @relation(fields: [organizer_id], references: [id])
  event        events         @relation(fields: [event_id], references: [id])
  transactions transactions[]

  @@map("vouchers")
}

model coupons {
  id        String        @id @default(uuid())
  code      String        @unique
  type      discount_type
  value     Decimal
  is_active Boolean       @default(true)

  created_at DateTime  @default(now())
  update_at  DateTime  @updatedAt
  deleted_at DateTime?

  issuances coupon_issuances[]

  @@map("coupons")
}

model coupon_issuances {
  id         String    @id @default(uuid())
  coupon_id  String
  user_id    String
  issued_at  DateTime  @default(now())
  expires_at DateTime
  used_at    DateTime?
  status     String    @default("unused")

  coupon       coupons        @relation(fields: [coupon_id], references: [id])
  user         users          @relation(fields: [user_id], references: [id])
  transactions transactions[]

  @@map("coupon_issuances")
}

model referral_uses {
  id          String   @id @default(uuid())
  referrer_id String
  referee_id  String   @unique
  referred_at DateTime @default(now())

  referrer users @relation("Referrer", fields: [referrer_id], references: [id])
  referee  users @relation("Referee", fields: [referee_id], references: [id])

  @@map("referral_uses")
}

model point_ledger {
  id             String    @id @default(uuid())
  user_id        String
  points         Int
  reason         String
  related_txn_id String?
  granted_at     DateTime  @default(now())
  expires_at     DateTime
  consumed_at    DateTime?
  note           String?

  user users @relation(fields: [user_id], references: [id])

  @@map("point_ledger")
}

model transactions {
  id                 String     @id @default(uuid())
  user_id            String
  organizer_id       String
  status             txn_status @default(WAITING_PAYMENT)
  subtotal_idr       Decimal    @default(0)
  discount_voucher   Decimal    @default(0)
  discount_coupon    Decimal    @default(0)
  discount_points    Decimal    @default(0)
  fees_idr           Decimal    @default(0)
  total_idr          Decimal    @default(0)
  voucher_id         String
  coupon_issuance_id String
  points_debited     Int        @default(0)
  payment_proof_url  String
  proof_uploaded_at  DateTime
  proof_due_at       DateTime
  confirm_due_at     DateTime

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  user                users                 @relation(fields: [user_id], references: [id])
  organizer           organizers            @relation(fields: [organizer_id], references: [id])
  voucher             vouchers              @relation(fields: [voucher_id], references: [id])
  coupon_issuance     coupon_issuances      @relation(fields: [coupon_issuance_id], references: [id])
  transaction_items   transaction_items[]
  email_notifications email_notifications[]

  @@map("transactions")
}

model transaction_items {
  id             String  @id @default(uuid())
  transaction_id String
  event_id       String
  ticket_type_id String
  quantity       Int     @default(1)
  unit_price_idr Decimal
  line_total_idr Decimal

  transaction transactions @relation(fields: [transaction_id], references: [id])
  event       events       @relation(fields: [event_id], references: [id])
  ticket_type ticket_types @relation(fields: [ticket_type_id], references: [id])
  tickets     tickets[]

  @@map("transaction_items")
}

model tickets {
  id                  String        @id @default(uuid())
  transaction_item_id String
  event_id            String
  ticket_type_id      String
  ticket_code         String        @unique
  status              ticket_status @default(VALID)
  issued_at           DateTime      @default(now())
  checked_in_at       DateTime

  transaction_item transaction_items @relation(fields: [transaction_item_id], references: [id])
  event            events            @relation(fields: [event_id], references: [id])
  ticket_type      ticket_types      @relation(fields: [ticket_type_id], references: [id])
  review           reviews[]
  checkin          checkins?

  @@map("tickets")
}

model checkins {
  id              String   @id @default(uuid())
  ticket_id       String   @unique
  gate            String
  scanned_by_user String
  scanned_at      DateTime @default(now())

  ticket tickets @relation(fields: [ticket_id], references: [id])
  user   users?  @relation(fields: [scanned_by_user], references: [id])

  @@map("checkins")
}

model reviews {
  id          String @id @default(uuid())
  event_id    String
  reviewer_id String
  ticket_id   String
  rating      Int
  comment     String

  created_at DateTime @default(now())

  event    events   @relation(fields: [event_id], references: [id])
  reviewer users    @relation(fields: [reviewer_id], references: [id])
  ticket   tickets? @relation(fields: [ticket_id], references: [id])

  @@map("reviews")
}

model email_notifications {
  id             String   @id @default(uuid())
  user_id        String
  transaction_id String
  type           String
  sent_at        DateTime @default(now())
  payload        String

  user        users         @relation(fields: [user_id], references: [id])
  transaction transactions? @relation(fields: [transaction_id], references: [id])

  @@map("email_notifications")
}
